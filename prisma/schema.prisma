generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id             String   @id @default(uuid())
  tfgId          String   @unique
  fullName       String
  phone          String
  membershipType String
  totalPaid      Float
  dueDate        DateTime
  status         String
  createdAt      DateTime @default(now())
}